{
  "name": "baseline",
  "productName": "Baseline",
  "version": "0.1.1",
  "description": "Home for your apps and files: start a spreadsheet in Gridline or an image in Pixelline, and reopen recent work from both.",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "LucasHeh47",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasHeh47/baseline.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "npm run build && electron-builder --win --publish never && node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "lucide": "^1.55.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.baseline.app",
    "productName": "Baseline",
    "copyright": "Baseline",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "LucasHeh47",
        "repo": "baseline",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Baseline",
      "artifactName": "Baseline-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Baseline-Portable-${version}.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
